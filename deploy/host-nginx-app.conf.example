# Host-level nginx template — this file lives on the SERVER at
# /etc/nginx/sites-available/<app-name>.conf, NOT inside any Docker container.
# It is the one piece of config that makes "many apps, one server" work: every
# app gets one of these blocks, each pointing at that app's own gateway port.
#
# This copy in the repo (deploy/host-nginx-app.conf.example) is just the
# template/reference — copy it to the server and fill in the placeholders.
# See docs/deployment_plan.md for the full explanation and the "add another
# app" checklist.
#
# Placeholders to replace:
#   APP_PUBLIC_PORT   - the port this app is reached on from the internet, e.g. 8081
#                        (pick a new, unused one for each app)
#   APP_GATEWAY_PORT  - the 127.0.0.1-only port this app's "gateway" container
#                        publishes (matches APP_GATEWAY_PORT in that app's .env)

server {
    listen APP_PUBLIC_PORT;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:APP_GATEWAY_PORT;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Install on the server ---
#   sudo cp this-file /etc/nginx/sites-available/<app-name>.conf
#   sudo ln -s /etc/nginx/sites-available/<app-name>.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo ufw allow APP_PUBLIC_PORT/tcp
#
# --- Once a domain exists for this app (later) ---
#   Change to:
#     listen 80;
#     server_name yourapp.yourdomain.com;
#   (proxy_pass line stays exactly the same — Docker side never changes)
#   Then: sudo certbot --nginx -d yourapp.yourdomain.com


