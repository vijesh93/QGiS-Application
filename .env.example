# Proxy (leave empty if not behind a corporate proxy)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Database
DB_USER=geoportal_user
DB_PASSWORD=your_secure_password
DB_PASSWORD_URL=your_secure_password   # URL-encoded if password has special chars
POSTGRES_DB=geoportal

# Host ports (what gets exposed on your machine)
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
TITILER_HOST_PORT=8080
TILESERV_HOST_PORT=7800
DATA_LOADER_JUPYTER_HOST_PORT=8888

# Frontend (points browser at TiTiler on host)
VITE_TITILER_URL=http://localhost:8080
VITE_API_URL=/api/v1

# Ipynb settings
JUPYTER_URL=

# --- Production only (docker-compose.prod.yml) ---
# Public URL the app is reached at (used as the backend's CORS allow-origin).
# No domain yet: http://SERVER_IP:APP_GATEWAY_PUBLIC_PORT (see deploy/host-nginx-app.conf.example).
# Once a domain + TLS exist: https://yourapp.yourdomain.com
PUBLIC_APP_URL=http://SERVER_IP:8081

# Internal port the "gateway" container publishes to 127.0.0.1 only. Host nginx
# (outside Docker) proxies the public port above to this one. Pick a unique
# value per app if you run more than one on the same server (e.g. 9101, 9102, ...).
APP_GATEWAY_PORT=9101